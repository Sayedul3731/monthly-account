PORT=3001
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/daily_hisab
# Optional comma-separated resolvers for `mongodb+srv://` Atlas connections.
# Use this when your local DNS proxy refuses SRV queries, for example:
# MONGODB_DNS_SERVERS=1.1.1.1,1.0.0.1
MONGODB_DNS_SERVERS=

FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# Production requires two different, random secrets of at least 32 characters.
# Generate them with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Also set NODE_ENV=production, an HTTPS FRONTEND_URL, and the production API_URL.

# Google OAuth (create a Web application client in Google Cloud Console)
# The callback must exactly match the URL registered with Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# SMTP email verification (use port 465 with SMTP_SECURE=true, otherwise 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Daily Hisab <no-reply@example.com>"

# Manual Nagad payment collection. This number is intentionally shown to users
# on checkout; do not put a PIN, API key, or other secret here.
NAGAD_PAYMENT_NUMBER=

# Used by Vercel Cron to authorize the daily month-end summary run.
# Generate a long random value and add it to the production environment too.
CRON_SECRET=replace-with-a-long-random-cron-secret

# Copy this file to .env and update values before starting the API.
