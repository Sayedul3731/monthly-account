PORT=3001
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/daily_hisab

FRONTEND_URL=http://localhost:3000

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (create a Web application client in Google Cloud Console)
# The callback must exactly match the URL registered with Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Copy this file to .env and update values before starting the API.
